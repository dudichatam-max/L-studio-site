    <footer className="site-footer"><div className="container footer-inner"><SiteLogo compact /><div className="footer-links"><a href="#features">{text.features}</a><a href="#vision">{text.vision}</a><Link href="/privacy">{text.privacy}</Link></div><span className="footer-copy">© 2026 L Studio / BUILT FOR SOUND</span></div></footer>
