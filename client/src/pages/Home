b>WARM</b></div></div><div className="console-tabs"><span className="is-active">SOUND</span><span>MIC</span><span>LOOP</span><span>PAD</span><span>DRUM</span></div><div className="console-corner">L / 01 <span>▰▰▰</span></div></div></section>
