# Copy to .env for local Sandbox checkout. Never commit real secrets.

# PayPal REST app (Sandbox or Live). Dashboard: https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# Optional. Required only for POST /api/paypal/webhook signature checks.
PAYPAL_WEBHOOK_ID=

# Public Railway URL, no trailing slash. Used in emailed download links.
PUBLIC_BASE_URL=http://localhost:3000

# Long random string. Signs and encrypts one-time download tokens.
DOWNLOAD_TOKEN_SECRET=

PRODUCT_PRICE_USD=4.00
PRODUCT_NAME=L Studio Pro
SUPPORT_EMAIL=dudichatam@gmail.com

# Private APK. Set one of APK_PATH or APK_SOURCE_URL. Do not commit the file or a token.
# APK_PATH=/data/L-Studio-Pro.apk
#
# Private GitHub release (keep dudichatam-max/L-studio private). On a phone:
# 1. Open https://github.com/settings/personal-access-tokens/new
#    Resource owner: dudichatam-max. Only repository: L-studio.
#    Repository permissions: Contents = Read-only (covers releases). Leave every other permission off.
# 2. Railway → your service → Variables. Leave APK_PATH empty. Set:
#    APK_SOURCE_URL = either the browser download URL or the API asset URL:
#    https://github.com/dudichatam-max/L-studio/releases/download/website-pro-qa-welcomes-20260925/L-Studio-website-release.apk
#    https://api.github.com/repos/dudichatam-max/L-studio/releases/assets/588219111
#    APK_GITHUB_TOKEN = the fine-grained PAT (github_pat_…). Paste the token only, not the word Bearer.
# 3. Redeploy. Open /api/health and expect apkStatus "ready".
#    The stored file must match SHA256 28f976838cd6bed8daa77ebe6a84dd534028bca368cf551c62d49e3af1bd4436.
# GITHUB_TOKEN is used only when APK_GITHUB_TOKEN is unset. Prefer APK_GITHUB_TOKEN.
# APK_SOURCE_URL=
# APK_GITHUB_TOKEN=
# Override only when replacing the approved build.
# APK_SHA256=

# Durable directory for SQLite + fetched APK. On Railway, mount a volume here.
DATA_DIR=./data

# Free Early Access tester cap. Unique emails are stored in SQLite under DATA_DIR.
EARLY_ACCESS_LIMIT=44

# Optional. Links in the post-purchase download email. Production already defaults
# to the live site, so Railway does not need these.
# SITE_PUBLIC_URL=https://l-studio.studio
# GUIDE_URL=https://l-studio.studio/guide
# GUIDE_URL may also be a path, such as /guide, joined to SITE_PUBLIC_URL.

# Email is optional. With neither provider, the success page still shows the link.
# RESEND_API_KEY=
# RESEND_FROM="L Studio <downloads@your-domain>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Optional. GitHub Pages build only, when the buy page should call Railway.
# VITE_API_BASE_URL=https://your-service.up.railway.app
PORT=3000
